080:8080 \\\\\\n    --detach=true \\\\\\n    --name=cadvisor\\\\\\n    gcr.io/cadvisor/cadvisor:latest\\n\\n~$ docker ps -a\\n\"}]}]]}],\"\\n\"]}],\"\\n\"]}]\n2d:[\"$\",\"h4\",\"h4-13\",{\"children\":\"9. Install dan Konfigurasi Prometheus dengan SSL\"}]\n2e:[\"$\",\"ul\",\"ul-9\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Untuk langkah - langkah Installasi Prometheus bisa mengikuti dari postingan saya yang  \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":[\"$\",\"em\",\"em-0\",{\"children\":[\"$\",\"a\",\"a-0\",{\"href\":\"https://vianaja.github.io/blog-najwan/2024-11-01-prometheus/\",\"children\":\"Prometheus\"}]}]}],\". Dan dilanjutkan dengan konfigurasi di bwah ini untuk menambahkan TLS ke Prometheusnya.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Buat file \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":[\"$\",\"em\",\"em-0\",{\"children\":\"“web-config.yml”\"}]}],\" di directory \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-white font-bold\",\"children\":[\"$\",\"em\",\"em-0\",{\"children\":\"“/etc/prometheus/”\"}]}],\"  yang nantinya digunakan untuk koneksi ssl.\"]}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"yaml\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[