eft-1/2 w-0 h-[1px] bg-[#5ED0D3] transition-all group-hover:w-full group-hover:left-0\"}]]}],[\"$\",\"a\",\"Email\",{\"className\":\"font-body text-sm tracking-wide text-gray-500 hover:text-[#5ED0D3] transition-colors relative group\",\"href\":\"mailto:najwanoctavian@gmail.com\",\"target\":\"$undefined\",\"rel\":\"$undefined\",\"children\":[\"Email\",[\"$\",\"span\",null,{\"className\":\"absolute bottom-[-2px] left-1/2 w-0 h-[1px] bg-[#5ED0D3] transition-all group-hover:w-full group-hover:left-0\"}]]}],[\"$\",\"a\",\"GitHub\",{\"className\":\"font-body text-sm tracking-wide text-gray-500 hover:text-[#5ED0D3] transition-colors relative group\",\"href\":\"https://github.com/vianAja\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"GitHub\",[\"$\",\"span\",null,{\"className\":\"absolute bottom-[-2px] left-1/2 w-0 h-[1px] bg-[#5ED0D3] transition-all group-hover:w-full group-hover:left-0\"}]]}],[\"$\",\"a\",\"LinkedIn\",{\"className\":\"font-body text-sm tracking-wide text-gray-500 hover:text-[#5ED0D3] transition-colors relative group\",\"href\":\"https://www.linkedin.com/in/najwan-octa/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"LinkedIn\",[\"$\",\"span\",null,{\"className\":\"absolute bottom-[-2px] left-1/2 w-0 h-[1px] bg-[#5ED0D3] transition-all group-hover:w-full group-hover:left-0\"}]]}]]}]]}]}]\n:HL[\"/assets/images/secure-prometheus/topologi_secure_prome.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/alur-kerja.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/uptime.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/disk.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/memory.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/cpu.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/traffic.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/container.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/cpu-container.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/stats-web.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/total-request.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/tic_tac_toe.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/web_2048.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/alert_nginx.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/alert_apache.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/alert_container.png\",\"image\"]\n:HL[\"/assets/images/secure-prometheus/alert_traffic.png\",\"image\"]\n14:[\"$\",\"h3\",\"h3-1\",{\"className\":\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\",\"children\":\"Topologi\"}]\n15:[\"$\",\"div\",\"p-3\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"$\",\"img\",\"img-0\",{\"src\":\"/assets/images/secure-prometheus/topologi_secure_prome.png\",\"alt\":\"Branching\"}]}]\n16:[\"$\",\"h3\",\"h3-2\",{\"className\":\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\",\"children\":\"Alur kerja\"}]\n17:[\"$\",\"div\",\"p-4\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"$\",\"img\",\"img-0\",{\"src\":\"/assets/images/secure-prometheus/alur-kerja.png\",\"alt\":\"Branching\"}]}]\n18:[\"$\",\"h4\",\"h4-0\",{\"children\":\"Apache\"}]\n19:[\"$\",\"div\",\"p-5\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"        Apache adalah salah satu software web server gratis dan open source, yang memungkinkan pengguna mengupload website nya ke internet. Apache sendiri sudah hampir menjadi platform website bagi kurang lebih 33% website di dunia, dengan nama resmi “Apache HTTP Server”. Apache pertama kali dirilis pada tahun 1995 dan dikelola oleh “Apache Software Foundation”.\"}]\n1a:[\"$\",\"h4\",\"h4-1\",{\"children\":\"Nginx\"}]\n1b:[\"$\",\"div\",\"p-6\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"        NGINX (Engine-X) adalah salah satu web server yang banyak digunakan untuk membuat suatu website, dan digunakan hampir 34% dari seluruh website yang ada di internet. Nginx memiliki daya tarik karena sifatnya sebagai server HTTP, Reverse proxy, dan load balancer.\"}]\n1c:[\"$\",\"h4\",\"h4-2\",{\"children\":\"Exporter Prometheus\"}]\n1d:[\"$\",\"div\",\"p-7\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"        Exporter Prometheus adalah suatu tools yang digunakan untuk mengubah data metrics dari suatu layanan aplikasi atau sistem yang tadinya tidak bisa di baca oleh Prometheus menjadi bisa di baca, bertindak sebagai perantara untuk layanan yang di pantau dengan Prometheus.\"}]\n1e:[\"$\",\"h4\",\"h4-3\",{\"children\":\"CAdvisor\"}]\n1f:[\"$\",\"div\",\"p-8\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"        Cadvisor (Container Advisor) adalah suatu tools yang digunakan untuk memonitoring atau memantau performa / kinerja dari suatu container, serta mengambil data metrics dari Container, seperti penggunaan CPU, Memory, Traffic jaringan atau Disk I/O dari setiap container yang ada.\"}]\n20:[\"$\",\"h4\",\"h4-4\",{\"children\":\"SSL (Secure Sockets Layer)\"}]\n21:[\"$\",\"div\",\"p-9\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"        SSL merupakan Protocol keamanan yang digunakan untuk mengenkrip si data seperti informasi pribadi, password, rekening, dan data lain yang bersifat sensitif, saat data dikirim kan ke server, data tersebut akan di enkripsi untuk menjaga keamanan dari data tersebut. SSL sertifikat yaitu sertifikat digital digunakan untuk autentikasi indentitas dari situs web yang memungkinkan koneksi enkripsi yang aman. Dan sering digunakan untuk menjaga keamanan data pengguna yang perlu memverifikasi kepemilikan situs website.\"}]\n22:[\"$\",\"h3\",\"h3-3\",{\"className\":\"font-headline text-2xl font-bold text-white track