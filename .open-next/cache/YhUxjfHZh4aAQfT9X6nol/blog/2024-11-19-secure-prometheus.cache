0.6875rem] uppercase tracking-[0.1em] px-3 py-1 rounded-sm shadow-sm\",\"children\":\"Grafana\"}],[\"$\",\"span\",\"NGINX\",{\"className\":\"bg-surface-container-highest text-primary font-label text-[0.6875rem] uppercase tracking-[0.1em] px-3 py-1 rounded-sm shadow-sm\",\"children\":\"NGINX\"}],[\"$\",\"span\",\"Apache\",{\"className\":\"bg-surface-container-highest text-primary font-label text-[0.6875rem] uppercase tracking-[0.1em] px-3 py-1 rounded-sm shadow-sm\",\"children\":\"Apache\"}],[\"$\",\"span\",\"Docker\",{\"className\":\"bg-surface-container-highest text-primary font-label text-[0.6875rem] uppercase tracking-[0.1em] px-3 py-1 rounded-sm shadow-sm\",\"children\":\"Docker\"}],[\"$\",\"span\",\"Python\",{\"className\":\"bg-surface-container-highest text-primary font-label text-[0.6875rem] uppercase tracking-[0.1em] px-3 py-1 rounded-sm shadow-sm\",\"children\":\"Python\"}]]}],[\"$\",\"span\",null,{\"className\":\"text-outline font-label text-[0.6875rem] uppercase tracking-[0.1em]\",\"children\":\"5 Min Read\"}]]}],[\"$\",\"h1\",null,{\"className\":\"font-headline text-4xl md:text-6xl lg:text-7xl font-bold tracking-[-0.04em] text-white leading-tight mb-8\",\"children\":\"Secure Prometheus\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-12 h-12 rounded-full overflow-hidden bg-surface-container-high border border-outline-variant/20 shadow-md\",\"children\":[\"$\",\"img\",null,{\"className\":\"w-full h-full object-cover\",\"alt\":\"Author portrait\",\"src\":\"https://lh3.googleusercontent.com/aida-public/AB6AXuDHqr642FyWGJoOiZp-JrM_4jTdGgu4Pa6IUUVTJk5yGbpt2oQS--BENfMtgrKWDgY_8cvHEFl5rIZVh7ySDomdU0wT3NyVId8T7-z0FnIvUj_USKaVABQFeaOxeL4UFvQTbEHn6W9hFpb-k9Ims7nLVNFKZcafNkyDO0-9EMagi7vIcvXKywrKjT06m3tNxPeYb9poFso6A_GpU83Qn5ria04gCfHP39eF7OghBANpXj-WWGa12zM8SPcEdIJL4_iFUBpa0MPFs-xh\"}]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-white font-bold text-sm tracking-tight drop-shadow-md\",\"children\":\"Najwan Octavian Gerrard\"}],[\"$\",\"p\",null,{\"className\":\"text-outline font-label text-[0.6875rem] uppercase tracking-wider drop-shadow-md\",\"children\":[\"Lead Curator • \",\"2024-11-19\"]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"hidden lg:flex w-auto justify-end pl-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"inline-flex flex-col items-end gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-[2px] h-32 bg-gradient-to-b from-primary/0 via-primary/50 to-primary/0\"}],\"$L11\"]}]}]]}]}]]}],\"$L12\"]}],\"$L13\"]\n11:[\"$\",\"p\",null,{\"className\":\"font-headline text-sm text-outline uppercase tracking-widest [writing-mode:vertical-rl] drop-shadow-md\",\"children\":\"Scroll to Explore\"}]\n12:[\"$\",\"article\",null,{\"className\":\"w-full max-w-7xl mx-auto px-5 md:px-8 mb-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-full space-y-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose prose-invert max-w-none\",\"children\":[[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Di zaman modern sekarang yang serba otomatis serta kebutuhan akan monitoring atau pengecekan secara berkala, membuat kebutuhan akan tools automation monitoring yang canggih tanpa adanya campur tangan manusia untuk pengambilan data yang di monitoring tersebut, seperti penggunaan CPU, memory, disk atau traffic jaringan, menjadi semakin meningkat. Prometheus adalah salah satu solusi akan hal tersebut, yang menyediakan cara monitoring real time tanpa perlu adanya campur tangan manusia saat mengambil data yang harus di monitoring.\"}],\"\\n\",[\"$\",\"div\",\"p-1\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Dan dibutuhkan juga tools untuk visualisasi agar memudahkan dalam melakukan monitoring suatu system, aplikasi maupun server, Grafana disini berperan sebagai tools visualisasi yang sangat popular, karena kemampuannya dalam menangani visualisasi dengan banyak tools lain, sehingga lebih fleksible.\"}],\"\\n\",[\"$\",\"div\",\"p-2\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Serta dibutuhkan juga Alerting agar dapat memberikan peringatan dini terkait semisal adanya ganguan pada system yang menyebabkan system down, atau semisal ada terkait ancaman Cyber crime seprti DoS atau DDoS. Alert Manager Prometheus yang mengambil peran ini, yang nantinya akan mengirimkan peringatan apabila terjadi hal – hal tadi, sehingga meminimalisir terjadinya kerusakan pada system atau aplikasi kita. Alert Manager sendiri dapat di integrasikan dengan beberapa tools untuk notifikasi lain seperti Discord, Email atau WebHook Endpoint. Sehingga lebih fleksible dalam penggunaan alerting nya.\"}],\"\\n\",[\"$\",\"h3\",\"h3-0\",{\"className\":\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\",\"children\":\"Tools yang Digunakan\"}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Prometheus – 2.48.1\"}]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Grafana – 11.2.2\"}]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Alert Manager – 0.26.0\"}]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Node Exporter – 1.8.2\"}]}],\"\\n\",[\"$\",\"li\",\"li-4\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Nginx – 1.10.0\"}]}],\"\\n\",[\"$\",\"li\",\"li-5\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Nginx Exporter – 0.11.0\"}]}],\"\\n\",[\"$\",\"li\",\"li-6\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Apache2 – 2.4.52\"}]}],\"\\n\",[\"$\",\"li\",\"li-7\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Apache Exporter – 1.0.3\"}]}],\"\\n\",[\"$\",\"li\",\"li-8\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Docker – 27.3.1\"}]}],\"\\n\",[\"$\",\"li\",\"li-9\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"cAdvisor\"}]}],\"\\n\",[\"$\",\"li\",\"li-10\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Python – 3.10.12\"}]}],\"\\n\",[\"$\",\"li\",\"li-11\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Discord\"}]}],\"\\n\",[\"$\",\"li\",\"li-12\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Email\"}]}],\"\\n\"]}],\"\\n\",\"<br>\",\"\\n\",\"$L14\",\"\\n\",\"$L15\",\"\\n\",\"<br>\",\"\\n\",\"$L16\",\"\\n\",\"$L17\",\"\\n\",\"<br>\",\"\\n\",\"$L18\",\"\\n\",\"$L19\",\"\\n\",\"$L1a\",\"\\n\",\"$L1b\",\"\\n\",\"$L1c\",\"\\n\",\"$L1d\",\"\\n\",\"$L1e\",\"\\n\",\"$L1f\",\"\\n\",\"$L20\",\"\\n\",\"$L21\",\"\\n\",\"<br>\",\"\\n\",\"$L22\",\"\\n\",\"$L23\",\"\\n\",\"$L24\",\"\\n\",\"<br>\",\"\\n\",\"$L25\",\"\\n\",\"$L26\",\"\\n\",\"<br>\",\"\\n\",\"$L27\",\"\\n\",\"$L28\",\"\\n\",\"<br>\",\"\\n\",\"$L29\",\"\\n\",\"$L2a\",\"\\n\",\"<br>\",\"\\n\",\"$L2b\",\"\\n\",\"$L2c\",\"\\n\",\"<br>\",\"\\n\",\"$L2d\",\"\\n\",\"$L2e\",\"\\n\",\"$L2f\",\"\\n\",\"$L30\",\"\\n\",\"<br>\",\"\\n\",\"$L31\",\"\\n\",\"$L32\",\"\\n\",\"$L33\",\"\\n\",\"$L34\",\"\\n\",\"<br>\",\"\\n\",\"$L35\",\"\\n\",\"$L36\",\"\\n\",\"<br>\",\"\\n\",\"$L37\",\"\\n\",\"$L38\",\"\\n\",\"<br>\",\"\\n\",\"$L39\",\"\\n\",\"$L3a\",\"\\n\",\"<br>\",\"\\n\",\"$L3b\",\"\\n\",\"$L3c\",\"\\n\",\"$L3d\",\"\\n\",\"<br>