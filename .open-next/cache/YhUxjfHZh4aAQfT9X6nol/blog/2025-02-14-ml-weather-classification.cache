ading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-python\",\"children\":\"x_train, x_test, y_train, y_test = train_test_split(\\n  dataset, \\n  y_target,\\n  test_size=0.2,\\n  random_state=50\\n)\\n\"}]}]]}],\"\\n\"]}]\n20:[\"$\",\"li\",\"li-7\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Kemudian selanjutnya yaitu menentukan parameter untuk model Machine Learning ini. Seperti ini kurang lebih keterangannya :\"}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"objective: 'multi:softmax'\"}],\" Untuk menentukan jenis klasifikasi. \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-white font-bold\",\"children\":\"'multi:softmax'\"}],\" berarti model menggunakan softmax untuk klasifikasi multikelas.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"num_class: len(df.columns[:-1])\"}],\" Untuk menentukan jumlah kelas dalam masalah klasifikasi. \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-white font-bold\",\"children\":\"df.columns[:-1]\"}],\" mengambil semua kolom kecuali kolom terakhir (biasanya label/target).\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"eta: 0.01\"}],\" Untuk Learning rate, juga dikenal sebagai step size shrinkage. Nilai kecil (misalnya 0.01) membantu model belajar lebih lambat tetapi lebih stabil.\"]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"max_depth: 6\"}],\" Untuk menentukan kedalaman maksimum pohon keputusan dalam model. Kedalaman yang lebih besar dapat meningkatkan kapasitas model tetapi juga meningkatkan risiko overfitting.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"python\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-python\",\"children\":\"parameters = {\\n    'objective':'multi:softmax',\\n    'num_class': len(df.columns[:-1]),\\n    'eta': 0.01,\\n    'max_depth': 6,\\n}\\n\"}]}]]}],\"\\n\"]}]\n21:[\"$\",\"li\",\"li-8\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Melakukan Pembuatan Model dengan XGBClassifier, lalu save model ke file \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"XGBClassifier.json\"}],\".\"]}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline up