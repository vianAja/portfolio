ex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-python\",\"children\":\"model = xgb.XGBClassifier(\\n    parameters\\n)\\nmodel.fit(x_train, y_train)\\nmodel.save_model(\\\"XGBClassifier.json\\\")\\n\"}]}]]}],\"\\n\"]}]\n17:[\"$\",\"li\",\"li-9\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Melakukan Pengujian terkait Model nya, apakah bagus atau tidak. Untuk pengukurannya sendiri, semakin dekat angka accuracy dari model mendekati angka 1, maka model tersebut sangat baik. Jika angka nya di bawah 0.5, bisa di kategorikan model tersebut kurang layak digunakan, karena prediksi nya hampir banyak salah nya dari pada benarnya\"}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"python\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-r