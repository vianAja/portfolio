ldren\":\"Machine learning\"}]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[\"$\",\"a\",\"a-0\",{\"href\":\"https://vianaja.github.io/blog-najwan/2024-2-16-deep-learning/\",\"children\":\"Deep learning\"}]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":[\"$\",\"a\",\"a-0\",{\"href\":\"https://vianaja.github.io/blog-najwan/2024-2-16-natural-language-processing/\",\"children\":\"Natural Language Processing (NLP)\"}]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"children\":[\"$\",\"a\",\"a-0\",{\"href\":\"https://vianaja.github.io/blog-najwan/2024-2-16-computer-vision/\",\"children\":\"Computer Vision\"}]}],\"\\n\",[\"$\",\"li\",\"li-4\",{\"children\":[\"$\",\"a\",\"a-0\",{\"href\":\"https://vianaja.github.io/blog-najwan/2024-2-16-reinforcement-learning/\",\"children\":\"Reinforcement Learning\"}]}],\"\\n\",[\"$\",\"li\",\"li-5\",{\"children\":[\"$\",\"a\",\"a-0\",{\"href\":\"https://vianaja.github.io/blog-najwan/2024-2-16-robotics/\",\"children\":\"Robotics\"}]}],\"\\n\",[\"$\",\"li\",\"li-6\",{\"children\":[\"$\",\"a\",\"a-0\",{\"href\":\"https://vianaja.github.io/blog-najwan/2024-2-16-speech-recognition/\",\"children\":\"Speech Recognition\"}]}],\"\\n\"]}]\n9:[\"$\",\"div\",\"p-4\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Pada tahun sekitar 2024, AI sendiri mengalami kemajuan yang cukup signifikan, yang dimana terus berkembang hingga ada yang namanya Generative AI (Gen AI)\"}]\na:[\"$\",\"h3\",\"h3-1\",{\"className\":\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\",\"children\":\"Gererative AI (gen AI)\"}]\nb:[\"$\",\"div\",\"p-5\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Gererative AI sendiri merupakan Artificial Intelligence yang dirancang untuk membuat konten baru berdasarkan data yang sudah dipelajari sebelumnya, seperti membuat konten teks, gambar, audio, bahkan video, dan sebenarnya masih banyak lainnya juga, dan hasilnya pun cukup sulit dibedakan dengan karya tangan manusia.\"}]\nc:[\"$\",\"div\",\"p-6\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Generative AI dapat di simpulkan yaitu sebuah algoritma pembelajaran yang mana nantinya akan membuat sebuah prediksi dan menciptakan sebuah konten atau karya dalam aneka bentuk, baik itu teks, gambar, video, dll. Contoh dari implementasi Gen AI sendiri itu seperti ChatGPT, DeepSeek, atau Gemini.\"}]\nd:[\"$\",\"div\",\"p-7\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Akankah Artificial Intelligence (AI) atau Generative AI ini dapat menggantikan manusia pada masa depan?\"}]\ne:[\"$\",\"div\",\"p-8\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Tuliskan Pendapatmu di kolom komentar ya. Jangan lupa nantikan Blog saya yang lainnya. Thank you, see you next time...\"}]\nf:[\"$\",\"footer\",null,{\"className\":\"w-full py-12 mt-20 bg-[#1a1c1e]\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col md:flex-row justify-between items-center px-8 max-w-7xl mx-auto gap-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center md:items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-headline font-bold text-[#5ED0D3] text-xl\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/\",\"className\":\"text-2xl font-bold tracking-tighter text-white font-headline\",\"children\":\"NAJWAN\"}]}],[\"$\",\"p\",null,{\"className\":\"font-body text-sm tracking-wide text-gray-500\",\"children\":[\"© \",2026,\" Najwan. All rights reserved.\"]}]]}],[\"$\",\"div\",null,{\"className\":\"flex gap-8\",\"children\":[[\"$\",\"a\",\"WhatsApp\",{\"className\":\"font-body text-sm tracking-wide text-gray-500 hover:text-[#5ED0D3] transition-colors relative group\",\"href\":\"https://wa.me/62895414361074\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"WhatsApp\",[\"$\",\"span\",null,{\"className