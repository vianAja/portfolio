{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/projects/layout,_N_T_/projects/[slug]/layout,_N_T_/projects/[slug]/page,_N_T_/projects/2026-04-10-oracle-19c-trainer"},"segmentPaths":["/_tree","/_full","/projects/$d$slug/__PAGE__","/projects/$d$slug","/projects","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" class=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/assets/img/wallpaper2.webp\" as=\"image\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/07inbngrub1cy.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/045g~0~zva_mv.js\"/><script src=\"/_next/static/chunks/146rw096sf~36.js\" async=\"\"></script><script src=\"/_next/static/chunks/0h-b6npt-.od0.js\" async=\"\"></script><script src=\"/_next/static/chunks/0257pdz1-imal.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0cr~o5sxw-i8y.js\" async=\"\"></script><script src=\"/_next/static/chunks/01xlw8hd842-c.js\" async=\"\"></script><script src=\"/_next/static/chunks/0d3shmwh5_nmn.js\" async=\"\"></script><script src=\"/_next/static/chunks/0fmi82_qvhp2c.js\" async=\"\"></script><link rel=\"preload\" href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=Manrope:wght@300;400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap\" as=\"style\"/><link rel=\"preload\" href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" as=\"style\"/><title>Oracle Database 19c Technical Trainer | NAJWAN</title><meta name=\"description\" content=\"Delivering comprehensive training content for Oracle Database 19c administration, culminating in advanced enterprise backup and recovery strategies using RMAN.\"/><link rel=\"icon\" href=\"/icon.svg?icon.0qulvj.f26cwm.svg\" sizes=\"any\" type=\"image/svg+xml\"/><link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=Manrope:wght@300;400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><nav class=\"fixed top-0 w-full z-50 bg-[#121416]/60 backdrop-blur-xl border-b border-white/5\"><div class=\"flex justify-between items-center px-8 py-4 max-w-7xl mx-auto\"><a class=\"text-2xl font-bold tracking-tighter text-white font-headline\" href=\"/\">NAJWAN</a><div class=\"hidden md:flex items-center gap-8\"><a class=\"font-headline tracking-tighter uppercase text-sm transition-colors pb-0.5 text-primary border-b-2 border-primary\" href=\"/projects\">Projects</a><a class=\"font-headline tracking-tighter uppercase text-sm transition-colors pb-0.5 text-gray-400 hover:text-white\" href=\"/blog\">Blog</a><a class=\"font-headline tracking-tighter uppercase text-sm transition-colors pb-0.5 text-gray-400 hover:text-white\" href=\"/timeline\">Timeline</a><a class=\"font-headline tracking-tighter uppercase text-sm transition-colors pb-0.5 text-gray-400 hover:text-white\" href=\"/contact\">Contact</a><a class=\"bg-gradient-to-br from-primary to-primary-container text-on-primary-container font-headline tracking-tighter uppercase text-sm px-6 py-2 rounded-full font-bold hover:scale-95 transition-all duration-200 ml-4\" href=\"/\">HOME</a></div><button class=\"md:hidden text-white flex items-center justify-center p-2\"><span class=\"material-symbols-outlined text-3xl\">menu</span></button></div></nav><main class=\"pt-24\"><header class=\"relative w-full max-w-7xl mx-auto px-8 mb-16\"><div class=\"w-full\"><div class=\"w-full\"><div class=\"flex items-center gap-3 mb-6\"><a class=\"flex items-center gap-1 text-outline hover:text-primary transition-colors font-label text-[0.6875rem] uppercase tracking-[0.1em]\" href=\"/projects\"><span class=\"material-symbols-outlined text-sm\">arrow_back</span>All Projects</a></div><div class=\"flex flex-wrap gap-2 mb-6\"><span class=\"bg-surface-container-highest text-primary font-label text-[0.6875rem] uppercase tracking-[0.1em] px-3 py-1 rounded-sm\">Oracle</span><span class=\"bg-surface-container-highest text-primary font-label text-[0.6875rem] uppercase tracking-[0.1em] px-3 py-1 rounded-sm\">Database</span><span class=\"bg-surface-container-highest text-primary font-label text-[0.6875rem] uppercase tracking-[0.1em] px-3 py-1 rounded-sm\">Training</span></div><h1 class=\"font-headline text-5xl md:text-7xl font-bold tracking-[-0.04em] text-white leading-tight mb-6\">Oracle Database 19c Technical Trainer</h1><p class=\"text-on-surface-variant text-xl leading-relaxed max-w-2xl\">Delivering comprehensive training content for Oracle Database 19c administration, culminating in advanced enterprise backup and recovery strategies using RMAN.</p><div class=\"flex items-center gap-6 mt-8\"><p class=\"text-outline font-label text-xs uppercase tracking-widest\">2026-04-10</p></div></div></div><div class=\"mt-16 relative aspect-[21/9] w-full rounded-xl overflow-hidden group\"><img class=\"w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-700\" alt=\"Oracle Database 19c Technical Trainer\" src=\"/assets/img/wallpaper2.webp\"/><div class=\"absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-40\"></div></div></header><article class=\"max-w-7xl mx-auto px-5 md:px-8 mb-24\"><div class=\"w-full space-y-4\"><div class=\"prose prose-invert max-w-none\"><div class=\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\">As the Technical Trainer for the Oracle Database 19c curriculum, I was responsible for architecting the technical syllabus and guiding its hands-on delivery. The curated material scales comprehensively from foundational relational architecture to enterprise-grade backup management.</div>\n<h3 class=\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\">Foundational Curriculum</h3>\n<div class=\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\">The introductory phase covers the core architecture of Oracle 19c Multitenant, where participants are trained extensively on Container Databases (CDBs) and Pluggable Databases (PDBs). The learning curve encompasses advanced instance installations, user profiling, role and privilege allocations, alongside optimal execution of storage and tablespace management.</div>\n<h3 class=\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\">Backup Management via RMAN</h3>\n<div class=\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\">The zenith of the technical bootcamp centered heavily on Disaster Recovery mitigation. Participants were directed through intensive, scenario-based operations of the Oracle Recovery Manager (RMAN):</div>\n<ul>\n<li>Designing and executing explicit Full and Incremental Backup architectures.</li>\n<li>Engineering and enforcing integrated Retention Policies.</li>\n<li>Delivering Point-In-Time database restorations mimicking critical scenarios involving lost data files or corrupted control files.</li>\n<li>Automating standardized RMAN schedules utilizing cron tasks and the Oracle Scheduler for dedicated operations and maintenance landscapes.</li>\n</ul></div></div></article></main><footer class=\"w-full py-12 mt-20 bg-[#1a1c1e]\"><div class=\"flex flex-col md:flex-row justify-between items-center px-8 max-w-7xl mx-auto gap-8\"><div class=\"flex flex-col items-center md:items-start gap-2\"><span class=\"font-headline font-bold text-[#5ED0D3] text-xl\"><a class=\"text-2xl font-bold tracking-tighter text-white font-headline\" href=\"/\">NAJWAN</a></span><p class=\"font-body text-sm tracking-wide text-gray-500\">© <!-- -->2026<!-- --> Najwan. All rights reserved.</p></div><div class=\"flex gap-8\"><a class=\"font-body text-sm tracking-wide text-gray-500 hover:text-[#5ED0D3] transition-colors relative group\" href=\"https://wa.me/62895414361074\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp<span class=\"absolute bottom-[-2px] left-1/2 w-0 h-[1px] bg-[#5ED0D3] transition-all group-hover:w-full group-hover:left-0\"></span></a><a class=\"font-body text-sm tracking-wide text-gray-500 hover:text-[#5ED0D3] transition-colors relative group\" href=\"mailto:najwanoctavian@gmail.com\">Email<span class=\"absolute bottom-[-2px] left-1/2 w-0 h-[1px] bg-[#5ED0D3] transition-all group-hover:w-full group-hover:left-0\"></span></a><a class=\"font-body text-sm tracking-wide text-gray-500 hover:text-[#5ED0D3] transition-colors relative group\" href=\"https://github.com/vianAja\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub<span class=\"absolute bottom-[-2px] left-1/2 w-0 h-[1px] bg-[#5ED0D3] transition-all group-hover:w-full group-hover:left-0\"></span></a><a class=\"font-body text-sm tracking-wide text-gray-500 hover:text-[#5ED0D3] transition-colors relative group\" href=\"https://www.linkedin.com/in/najwan-octa/\" target=\"_blank\" rel=\"noopener noreferrer\">LinkedIn<span class=\"absolute bottom-[-2px] left-1/2 w-0 h-[1px] bg-[#5ED0D3] transition-all group-hover:w-full group-hover:left-0\"></span></a></div></div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/045g~0~zva_mv.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"default\\\"]\\n5:I[97367,[\\\"/_next/