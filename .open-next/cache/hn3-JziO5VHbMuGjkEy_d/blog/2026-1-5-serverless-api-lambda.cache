.environ.get('TABLE_NAME')\\\\ntable = dynamodb.Table(TABLE_NAME)\\\\n\\\\ndef lambda_handler(event, context):\\\\n    # SQS mengirimkan data dalam bentuk list 'Records'\\\\n    for record in event['Records']:\\\\n        try:\\\\n            # 1. Parse body dari pesan SQS\\\\n            payload = json.loads(record['body'])\\\\n          \\\\n            # 2. Simpan ke DynamoDB\\\\n            # Pastikan payload memiliki 'Partition Key' yang sesuai dengan tabel Anda\\\\n            table.put_item(Item=payload)\\\\n          \\\\n            print(f\\\\\\\"Berhasil memproses pesan ID: {record['messageId']}\\\\\\\")\\\\n          \\\\n        except Exception as e:\\\\n            print(f\\\\\\\"Gagal memproses record {record['messageId']}: {str(e)}\\\\\\\")\\\\n            # Jika return error, SQS akan mencoba mengirim ulang pesan ini (Retry)\\\\n            raise e \\\\n\\\\n    return {\\\\n        'statusCode': 200,\\\\n        'body': json.dumps('Proses SQS ke DynamoDB selesai')\\\\n    }\\\\n\\\"}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"54:[\\\"$\\\",\\\"ul\\\",\\\"ul-21\\\",{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",\\\"strong-0\\\",{\\\"className\\\":\\\"text-white font-bold\\\",\\\"children\\\":\\\"Set Trigger SQS:\\\"}],\\\" Setting \\\",[\\\"$\\\",\\\"strong\\\",\\\"strong-1\\\",{\\\"className\\\":\\\"text-white font-bold\\\",\\\"children\\\":\\\"Trigger\\\"}],\\\"-nya arahin ke SQS yang udah kita buat. Jadi setiap ada pesan masuk ke SQS, Lambda ini bakal otomatis jalan.\\\"]}],\\\"\\\\n\\\"]}]\\n55:[\\\"$\\\",\\\"div\\\",\\\"p-32\\\",{\\\"className\\\":\\\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\\\",\\\"children\\\":[\\\"$\\\",\\\"img\\\",\\\"img-0\\\",{\\\"src\\\":\\\"/assets/images/lks/lambda-trigger-sqs1.png\\\",\\\"alt\\\":\\\"Lambda Trigger SQS 1\\\"}]}]\\n56:[\\\"$\\\",\\\"div\\\",\\\"p-33\\\",{\\\"className\\\":\\\"text-on-surface/80 font-body text-lg