 DB. (Best practice: pake\",[\"$\",\"em\",\"em-0\",{\"children\":\"least privilege\"}],\" ya!)\"]}]]}],[\"$\",\"tr\",\"tr-1\",{\"children\":[[\"$\",\"td\",\"td-0\",{\"style\":{\"textAlign\":\"left\"},\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"SQS Visibility Timeout\"}]}],[\"$\",\"td\",\"td-1\",{\"style\":{\"textAlign\":\"left\"},\"children\":\"> Lambda Timeout\"}],[\"$\",\"td\",\"td-2\",{\"style\":{\"textAlign\":\"left\"},\"children\":\"Durasi pesan \\\"hilang\\\" dari antrian saat diproses. Harus lebih lama dari durasi eksekusi Lambda Consumer.\"}]]}],[\"$\",\"tr\",\"tr-2\",{\"children\":[[\"$\",\"td\",\"td-0\",{\"style\":{\"textAlign\":\"left\"},\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Lambda Trigger\"}]}],[\"$\",\"td\",\"td-1\",{\"style\":{\"textAlign\":\"left\"},\"children\":\"Batch Size\"}],[\"$\",\"td\",\"td-2\",{\"style\":{\"textAlign\":\"left\"},\"children\":\"Jumlah pesan yang diambil Lambda Consumer sekali jalan. Default 10, bisa di-tuning sesuai kebutuhan.\"}]]}],[\"$\",\"tr\",\"tr-3\",{\"children\":[[\"$\",\"td\",\"td-0\",{\"style\":{\"textAlign\":\"left\"},\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"ALB Listener\"}]}],[\"$\",\"td\",\"td-1\",{\"style\":{\"textAlign\":\"left\"},\"children\":\"Port 80 (HTTP)\"}],[\"$\",\"td\",\"td-2\",{\"style\":{\"textAlign\":\"left\"},\"children\":\"Forwarding rule ke Target Group Lambda Ingest.\"}]]}]]}]]}]\n4d:[\"$\",\"h3\",\"h3-8\",{\"className\":\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\",\"children\":\"Validasi & Testing\"}]\n4e:[\"$\",\"div\",\"p-35\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Saatnya pembuktian! Apakah sistem kita jalan mulus?\"}]\n4f:[\"$\",\"ol\",\"ol-1\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"class