             MessageBody=body_raw\\n            )\\n          \\n            return {\\n                \\\"statusCode\\\": 200,\\n                \\\"headers\\\": {\\\"Content-Type\\\": \\\"application/json\\\"},\\n                \\\"body\\\": json.dumps({\\\"status\\\": \\\"Success\\\", \\\"msg\\\": \\\"Data masuk antrean SQS\\\"})\\n            }\\n        except Exception as e:\\n            print(f\\\"CRITICAL ERROR SQS: {str(e)}\\\")\\n            return {\\n                \\\"statusCode\\\": 500,\\n                \\\"body\\\": json.dumps({\\\"error\\\": f\\\"Gagal kirim ke SQS: {str(e)}\\\"})\\n            }\\n  \\n    else:\\n        return {\\n            \\\"statusCode\\\": 404,\\n            \\\"body\\\": json.dumps({\\\"error\\\": f\\\"Path {path} salah\\\"})\\n        }\\n36:[\\\"$\\\",\\\"div\\\",\\\"pre-0\\\",{\\\"clas\"])</script><script>self.__next_f.push([1,\"sName\\\":\\\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\\\",\\\"children\\\":\\\"python\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex gap-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"w-2 h-2 rounded-full bg-error/40\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"w-2 h-2 rounded-full bg-primary/40\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"w-2 h-2 rounded-full bg-secondary/40\\\"}]]}]]}],[\\\"$\\\",\\\"pre\\\",null,{\\\"className\\\":\\\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\\\",\\\"children\\\":[\\\"$\\\",\\\"code\\\",\\\"code-0\\\",{\\\"className\\\":\\\"language-python\\\",\\