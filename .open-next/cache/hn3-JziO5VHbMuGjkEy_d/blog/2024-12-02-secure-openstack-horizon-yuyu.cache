primary/0\"}],[\"$\",\"p\",null,{\"className\":\"font-headline text-sm text-outline uppercase tracking-widest [writing-mode:vertical-rl] drop-shadow-md\",\"children\":\"Scroll to Explore\"}]]}]}]]}]}]]}],[\"$\",\"article\",null,{\"className\":\"w-full max-w-7xl mx-auto px-5 md:px-8 mb-24\",\"children\":\"$L11\"}]]}],\"$L12\"]\n:HL[\"/assets/images/secure-openstack-horizon-yuyu/topologi_secure_openstack.png\",\"image\"]\n11:[\"$\",\"div\",null,{\"className\":\"w-full space-y-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose prose-invert max-w-none\",\"children\":[[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Perusahaan pada zaman modern saat ini telah mengimplementasikan private cloud menggunakan OpenStack untuk mengelola infrastruktur TI secara lebih fleksibel dan efisien. Namun, dalam operasional sehari-hari, tantangan sering muncul terkait dengan pengelolaan sumber daya dan meminimalkan risiko human error, terutama ketika pengembang melakukan pengujian pada lingkungan yang sama dengan produksi. Risiko ini dapat mengganggu stabilitas sistem dan mengakibatkan pemanfaatan resource cloud tidak efisiensi. Untuk mengatasi tantangan tersebut, manajer tim operasional berencana untuk memisahkan lingkungan antara project developer dan production.\"}],\"\\n\",[\"$\",\"div\",\"p-1\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Selain itu, perusahaan ingin memantau dan menghitung penggunaan resource secara terukur menggunakan Yuyu, sebuah solusi untuk pencatatan dan perhitungan pemakaian resource OpenStack dengan integrasi Yuyu, karena dapat melacak penggunaan sumber daya mulai dari volume, flavor, image, dan lain – lain, bahkan sampai router pada OpenStack yang digunakan. Serta dapat menganalisa biaya penggunaan agar dapat menghemat pengeluaran operasional perusahaan.\"}],\"\\n\",[\"$\",\"h3\",\"h3-0\",{\"className\":\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\",\"children\":\"Tools yang digunakan\"}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"OpenStack– Antelope – v2023.1\"}]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Kolla Ansible – v2023.1\"}]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Ansible – v2.14.18\"}]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Horizon – v2023.1\"}]}],\"\\n\",[\"$\",\"li\",\"li-4\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Yuyu – v2023.1\"}]}],\"\\n\",[\"$\",\"li\",\"li-5\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Python – 3.10.12\"}]}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",\"h2-0\",{\"className\":\"font-headline text-3xl font-bold text-white tracking-tight mt-12 mb-4\",\"children\":\"Topologi\"}],\"\\n\",[\"$\",\"div\",\"p-2\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"$\",\"img\",\"img-0\",{\"src\":\"/assets/images/secure-openstack-horizon-yuyu/topologi_secure_openstack.png\",\"alt\":\"Branching\"}]}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"font-headline text-3xl font-bold text-white tracking-tight mt-12 mb-4\",\"children\":\"Langkah Implementasi\"}],\"\\n\",[\"$\",\"h3\",\"h3-1\",{\"className\":\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\",\"children\":\"1. Konfigurasi SSL Certificate untuk service Horizon dan Yuyu.\"}],\"\\n\",[\"$\",\"ul\",\"ul-1\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface