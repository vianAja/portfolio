al/0=Horizon Najwan/OU=Horizon Najwan/CN=Horizon Najwan>\\\" \\\\\\n  -key /etc/ssl/horizon/horizon.key \\\\\\n  -out /etc/ssl/horizon/horizon.csr\\n\\nsudo openssl x509 -req -sha512 -days 3650 \\\\\\n  -key /etc/ssl/horizon/horizon.key \\\\\\n  -extfile /etc/ssl/IP_SANS.txt \\\\\\n  -in /etc/ssl/horizon/horizon.csr\\\\\\n  -out /etc/ssl/horizon/horizon.crt\\n\"}]}]]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Yuyu.\"}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"bash\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-bash\",\"children\":\"sudo openssl genrsa -out /etc/ssl/yuyu/yuyu.key 2048\\n\\nsudo openssl req -sha512 -new \\\\\\n  -subj \\\"/C=IN/ST=jateng/L=kendal/0=Yuyu Najwan/OU=Yuyu Najwan/CN=Yuyu Najwan>\\\" \\\\\\n  -key /etc/ssl/yuyu/yuyu.key \\\\\\n  -out /etc/ssl/yuyu/yuyu.csr\\n\\nsudo openssl x509 -req -sha512 -days 3650 \\\\\\n  -key /etc/ssl/yuyu/yuyu.key \\\\\\n  -extfile /etc/ssl/IP_SANS.txt \\\\\\n  -in /etc/ssl/yuyu/yuyu.csr\\\\\\n  -out /etc/ssl/yuyu/yuyu.crt\\n\"}]}]]}],\"\\n\"]}],\"\\n\"]}],\"\\n\"]}]\nd:[\"$\",\"li\",\"li-3\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Kemudian pindahkan file certificate (dengan format .crt ) yang sudah dibuat tadi, agar certificate nya di akui oleh system operasi ubuntu, agar tidak menjadi certificate self-signed. Karena untuk Django di Horizon perlu di buat seperti itu.\"}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"bash\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-bash\",\"children\":\"~$ sudo apt-get install ca-certificates\\n~$ sudo cp /etc/ssl/horizon/horizon.crt /usr/local/share/ca-certificates\\n~$ sudo cp /etc/ssl/yuyu/yuyu.crt /usr/local/share/ca-certificates\\n\\n~$ sudo update-ca-certificates\\n\"}]}]]}],\"\\n\"]}]\ne:[\"$\",\"h3\",\"h3-2\",{\"className\":\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\",\"children\":\"2. Install OpenStack dengan Kolla-Ansible\"}]\nf:[\"$\",\"div\",\"p-3\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"OpenStack terdiri dari beberapa service, yang nantinya berinteraksi satu sama dengan API dari setiap service yang ada, untuk service nya sendiri itu adalah sebagai berikut :\"}]\n10:[\"$\",\"ul\",\"ul-2\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Keystone\"}],\", untuk identity service (verifikasi akses).\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Neutron\"}],\", untuk Networking OpenStack.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Nova\"}],\", untuk Compute Service (yang Membuat Instance).\"]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Glance\"}],\", untuk menyimpan Image yang digunakan untuk membuat Instance.\"]}],\"\\n\",[\"$\",\"li\",\"li-4\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Cinder\"}],\", untuk membuat Volume yang digunakan Instance\"]}],\"\\n\",[\"$\",\"li\",\"li-5\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"RabbitMQ\"}],\", untuk Message Broker yang mengirim event dari komponen OpenStack.\"]}],\"\\n\"]}]\n11:[\"$\",\"div\",\"p-4\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Untuk lebih detail terkait Penjelasan dan Installasi nya bisa ke Postingan saya, akan tetapi harus menjalankan perintah di bawah ini terlebih dahulu. Karena nanti akan ada tambahan penyesuaian dan harus redeploy ulang cluster OpenStacknya, jadi lumayan ribet. Baru bisa mengikuti dari Postingan ini \",[\"$\",\"a\",\"a-0\",{\"href\":\"https://vianaja.github.io/blog-najwan/2024-10-19-openstack/\",\"children\":\"OpenStack and Kolla-Ansible\"}],\".\"]}]\n12:[\"$\",\"ul\",\"ul-3\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Edit pada file global.yaml untuk opsi enable TLS pada service internal OpenStack dan untuk copy CA ke Container Service nya, pada \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":[\"$\",\"em\",\"em-0\",{\"children\":\"{DIR_KOLLA}\"}]}],\" ubah menjadi \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-white font-bold\",\"children\":\"{{ node_config }}\"}],\" dan \",[\"$\",\"strong\",\"strong-2\",{\"className\":\"text-white font-bold\",\"children\":\"{DIR_KOLLA_CERT}\"}],\" pada ubah menjadi \",[\"$\",\"strong\",\"strong-3\",{\"className\":\"text-white font-bold\",\"children\":\"{{ kolla_certificates_dir }}\"}],\".\"]}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"yaml\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-yaml\",\"children\":\"openstack_cacert: \\\"/etc/ssl/certs/ca-certificates.crt\\\"\\nkolla_enable_tls_internal: \\\"yes\\\"\\nkolla_certificates_dir: \\\"{DIR_KOLLA}/certificates\\\"\\nkolla_admin_openrc_cacert: \\\"/etc/kolla/certificates/ca/root.crt\\\"\\nkolla_copy_ca_into_containers: \\\"yes\\\"\\nkolla_enable_tls_backend: \\\"yes\\\"\\nkolla_verify_tls_backend: \\\"no\\\"\\nkolla_tls_backend_cert: \\\"{DIR_KOLLA_CERT}/backend-cert.pem\\\"\\nkolla_tls_backend_key: \\\"{DIR_KOLLA_CERT}/backend-key.pem\\\"\\n\"}]}]]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"lalu pada step sebelum deploy, jalankan perintah ini untuk membuat Certificate.\"}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"bash\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-bash\",\"children\":\"(kolla-venv) student@controller:~$ kolla-ansible -i ./multinode certificates\\n\"}]}]]}],\"\\n\"]}],\"\\n\"]}]\n13:[\"$\",\"h3\",\"h3-3\",{\"className\":\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\",\"children\":\"3. Installasi Horizon dan Yuyu dengan TLS\"}]\n14:[\"$\",\"div\",\"p-5\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Service Horizon dan Yuyu atau lebih tepatnya Yuyu Api, keduanya menggunakan Django dalam Implementasinya, jadi untuk menambahkan opsi TLS, kita hanya perlu mengatur pada konfigurasi dari Django nya, untuk menambahkan file Certificate dan key Certificate. Untuk Installasi Horizon dan Yuyu, bisa kunjungi postingan saya yang ini \",[\"$\",\"a\",\"a-0\",{\"href\":\"https://vianaja.github.io/blog-najwan/2024-10-20-Yuyu-horizon/\",\"children\":\"Yuyu Billing in OpenStack Horizon\"}],\", untuk penjelasan serta hasil akhirnya juga.\"]}]\n15:[\"$\",\"div\",\"p-6\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Ada beberapa penyesuaian apabila ingin di tambahkan opsi TLS pada kedua service ini, yaitu sebagai berikut langkah - langkahnya\"}]\n16:[\"$\",\"h4\",\"h4-0\",{\"children\":\"A. Untuk di bagian Horizon\"}]\n17:[\"$\",\"ul\",\"ul-4\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Update konfigurasi dari \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"\\\"local_setting.py\\\"\"}],\" pada directory Horizon, seperti contoh saya letakan pada directory \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-white font-bold\",\"children\":\"/var/www/html/horizon/openstack_dashboard/local/\"}],\" menjadi seperti dibawah ini.\"]}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"python\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-python\",\"children\":\"WEBROOT = '/'\\nYUYU_URL = 'https://{IP HOST}:8182'\\n\\nSECURE_PROXY_SSL_HEADER = ('HTTP_X_FORWARDED_PROTO', 'https')\\nCSRF_COOKIE_SECURE = True\\nSESSION_COOKIE_SECURE = True\\n\\nOPENSTACK_KEYSTONE_URL = 'https://{IP HOST}:5000/v3'\\nOPENSTACK_KEYSTONE_DEFAULT_ROLE = 'member'\\nOPENSTACK_SSL_NO_VERIFY = False\\nOPENSTACK_SSL_CACERT = '/etc/ssl/certs/ca-certificates.crt'\\n\\nOPENSTACK_KEYSTONE_BACKEND = {\\n  'name': 'native',\\n  'can_edit_group': True,\\n  'can_edit_user': True,\\n  'can_edit_role': True,\\n  'can_edit_project': True,\\n  'can_edit_domain': True,\\n}\\n\"}]}]]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"pada saat generate file konfigurasi apache, tambahkan opsi seperti ini untuk auto generate apache conf dengan SSL/TLS.\"}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"bash\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-bash\",\"children\":\"~# ./manage.py make_web_conf --apache \\\\\\n  --sslkey  /etc/ssl/horizon/horizon.key \\\\\\n  --sslcert /etc/ssl/horizon/horizon.crt \\\\\\n  --cacert /etc/ssl/certs/ca-certificates.crt \\\\\\n  --ssl > /etc/apache2/sites-available/horizon.conf\\n\"}]}]]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"restart service Apache dan Memcached\"}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[\"$L23\",\"$L24\"]}],\"$L25\"]}],\"\\n\"]}],\"\\n\"]}]\n18:[\"$\",\"h4\",\"h4-1\",{\"children\":\"B. Untuk di bagian Yuyu Api\"}]\n19:[\"$\",\"ul\",\"ul-5\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Update konfigurasi dari \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"\\\"local_setting.py\\\"\"}],\" pada directory Yuyu API, seperti contoh, saya letakan pada directory \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-white font-bold\",\"children\":\"/var/yuyu/yuyu/\"}],\" menjadi seperti dibawah ini.\"]}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"python\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-python\",\"children\":\"ALLOWED_HOSTS = ['*']\\n\\nSECURE_PROXY_SSL_HEADER = ('HTTP_X_FORWARDED_PROTO', 'https')\\nSECURE_SSL_HOST = True\\nSECURE_SSL_REDIRECT = False\\nSESSION_COOKIE_SECURE = True\\nCSRF_COOKIE_SECURE = True\\n\"}]}]]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Lalu edit pada service Yuyu API, menjadi seperti berikut untuk menambahkan opsi TLS.\"}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"bash\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-bash\",\"children\":\"~# nano /etc/systemd/system/yuyu_api.service\\n\\nExecStart=/var/yuyu/env/bin/gunicorn yuyu.wsgi \\\\\\n  --workers 2 \\\\\\n  --keyfile  /etc/ssl/yuyu/yuyu.key \\\\\\n  --certfile /etc/ssl/yuyu/yuyu.crt \\\\\\n  --bind 10.18.18.10:8182 \\\\\\n  --log-file=logs/gunicorn.log\\n\"}]}]]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"lalu restart service Yuyu API, Apache dan Memcache.\"}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"bash\"}],[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]]}],\"$L26\"]}],\"\\n\"]}],\"\\n\"]}]\n1a:[\"$\",\"h3\",\"h3-4\",{\"className\":\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\",\"children\":\"Kendala yang mungkin dapat di terjadi saat pembuatan.\"}]\n1b:[\"$\",\"ul\",\"ul-6\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Error saat debug Login ke Project Admin via CLI dengan File Openrc.\\n\",[\"$\",\"img\",\"img-0\",{\"src\":\"/assets/images/secure-openstack-horizon-yuyu/error_ssl_openstack_cli.png\",\"alt\":\"Branching\"}],\"\\nSolusi:\"]}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"Ubah pada file Openrc pada bagian \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"\\\"export OS_CACERT\\\"\"}],\", kalau tidak ada bisa ditambahkan di line baru, isikan certificate ini \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-white font-bold\",\"children\":\"“/etc/kolla/certificates/ca/root.crt”\"}],\".\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[\"Bisa gunakan \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"”/etc/ssl/certs/ca-certificate.crt”\"}],\" pada saat berubah file openrc di bagian \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-white font-bold\",\"children\":[\"$\",\"em\",\"em-0\",{\"children\":\"export OS_CACERT\"}]}],\", apabila file \",[\"$\",\"strong\",\"strong-2\",{\"className\":\"text-white font-bold\",\"children\":\"“/etc/kolla/certificates/ca/root.crt”\"}],\" sudah di masukan ke ca-certificate ubuntu, dengan cara copy file \",[\"$\",\"strong\",\"strong-3\",{\"className\":\"text-white font-bold\",\"children\":\"“/etc/kolla/certificates/ca/root.crt”\"}],\" ke \",[\"$\",\"strong\",\"strong-4\",{\"className\":\"text-white font-bold\",\"children\":\"\\\"/usr/local/share/ca-certificates\\\"\"}],\", lalu update ca-certificates dengan perintah ini \",[\"$\",\"strong\",\"strong-5\",{\"className\":\"text-white font-bold\",\"children\":[\"$\",\"em\",\"em-0\",{\"children\":\"\\\"sudo update-ca-certificates\\\"\"}]}],\".\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Error \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"“SSLError at /admin/billing_overview/”\"}],\" saat membuka page Billing di Horizon,  karena Django yang digunakan oleh Horizon tidak diperbolehkan \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-white font-bold\",\"children\":\"“Self-Signed Certificate”\"}],\".\\n\",[\"$\",\"img\",\"img-0\",{\"src\":\"/assets/images/secure-openstack-horizon-yuyu/error_ssl_openstack.png\",\"alt\":\"Branching\"}],\"\\nSolusi:\"]}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"Tambahkan certificate Horizon dan Yuyu ke \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"\\\"/usr/local/share/ca-certificates\\\"\"}],\" lalu update ca-certificate, \",[\"$\",\"a\",\"a-0\",{\"href\":\"https://ubuntu.com/server/docs/install-a-root-ca-certificate-in-the-trust-store\",\"children\":\"referensi\"}]]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Error \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"“AttributeError at /auth/logout/”\"}],\"  saat logout atau sign out project di Horizon.\\n\",[\"$\",\"img\",\"img-0\",{\"src\":\"/assets/images/secure-openstack-horizon-yuyu/error_logout_openstack.png\",\"alt\":\"Branching\"}],\"\\nSolusi:\"]}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"Versi dari library \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"“python-memcached”\"}],\" harus menggunakan versi 1.59. kalau pake yang terbaru tidak bisa.\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Error saat mencoba curl dan ada log error seperti ini, \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"“Invalid HTTP_HOST header: ’10.18.18.10:8183’, you may need to add ’10.18.18.10’ to ALLOWED_HOSTS”\"}],\".\\n\",[\"$\",\"img\",\"img-0\",{\"src\":\"/assets/images/secure-openstack-horizon-yuyu/error_allow_host_openstack.png\",\"alt\":\"Branching\"}],\"\\nSolusi:\"]}],\"\\n\",\"$L27\",\"\\n\"]}],\"\\n\",\"$L28\",\"\\n\"]}]\n1c:[\"$\",\"h4\",\"h4-2\",{\"children\":[\"Untuk hasil akhir nya, kurang lebih sama seperti pada Postingan saya yang \",[\"$\",\"a\",\"a-0\",{\"href\":\"https://vianaja.github.io/blog-najwan/2024-10-20-Yuyu-horizon/\",\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"Yuyu Billing in OpenStack Horizon\"}]}]]}]\n1d:[\"$\",\"div\",\"p-7\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Di blog ini, saya berbagi pengalaman tentang bagaimana mengamankan layanan OpenStack, dashboard Horizon, dan Yuyu Billing OpenStack dengan menggunakan TLS (Transport Layer Security). Langkah-langkah yang saya jelaskan mencakup pembuatan sertifikat SSL, konfigurasi, hingga tips mengatasi masalah yang sering muncul.\"}]\n1e:[\"$\",\"div\",\"p-8\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Selain teknis, saya juga menambahkan gambaran topologi agar lebih mudah dipahami, terutama bagi yang baru terjun ke dunia cloud. Dengan langkah-langkah ini, layanan OpenStack jadi lebih aman, data yang dikirim juga terlindungi, dan pastinya bikin pengguna lebih percaya sama sistem yang kita bangun.\"}]\n1f:[\"$\",\"div\",\"p-9\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"Kalau kalian lagi cari cara untuk bikin OpenStack lebih aman atau ingin tahu tentang TLS, semoga tulisan ini bisa membantu ya!\"}]\n22:null\n23:[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"bash\"}]\n24:[\"$\",\"div\",null,{\"className\":\"flex gap-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}],[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]]}]\n25:[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-bash\",\"children\":\"~# systemctl restart apache2.service memcached\\n\"}]}]\n26:[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-bash\",\"children\":\"~# systemctl restart yuyu_api.service spache2.service memcached\\n\"}]}]\n27:[\"$\",\"ul\",\"ul-0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"Bisa setting untuk \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"“ALLOWED_HOSTS“\"}],\" pada file konfigurasi \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-white font-bold\",\"children\":\"“local_setting.py”\"}],\" dari Yuyu, bisa langsung ke IP \",[\"$\",\"strong\",\"strong-2\",{\"className\":\"text-white font-bold\",\"children\":\"10.18.18.10\"}],\" (menyesuaikan IP Host masing - masing) atau tanda bintang \",[\"$\",\"strong\",\"strong-3\",{\"className\":\"text-white font-bold\",\"children\":\"“ * ”\"}],\" jika ingin semua IP boleh masuk.\"]}],\"\\n\"]}]\n28:[\"$\",\"li\",\"li-4\",{\"children\":[\"\\n\",[\"$\",\"div\",\"p-0\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":[\"Error \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"“Did Not Connect: Potential Security Issue”\"}],\" pada Console Instance di Horizon, bisa disebabkan karena Certificate tidak public (Tidak Berbayar), atau karena Image yang di pakai Instance error.\\n\",[\"$\",\"img\",\"img-0\",{\"src\":\"/assets/images/secure-openstack-horizon-yuyu/error_console.png\",\"alt\":\"Branching\"}],\"\\nSolusi:\"]}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"Bisa coba klik di bawah kata \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"“Instance Console”\"}],\" yang ada kotak biru, lalu klik \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-white font-bold\",\"children\":\"“Click here to show only console”.\"}],\" Error itu bisa disebabkan karena Image yang dipakai rusak.\"]}],\"\\n\"]}],\"\\n\"]}]\n","/blog/$d$slug":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n4:[]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":\"$W4\",\"buildId\":\"hn3-JziO5VHbMuGjkEy_d\"}\n","/blog":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n4:[]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":\"$W4\",\"buildId\":\"hn3-JziO5VHbMuGjkEy_d\"}\n","/_index":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n3:I[37