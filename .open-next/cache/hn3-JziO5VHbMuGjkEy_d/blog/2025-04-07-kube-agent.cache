ildren\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-bash\",\"children\":\"- glab config set -h gitlab.adinusa.id git_protocol https\\n✓ Configured Git protocol.\\n- glab config set -h gitlab.adinusa.id api_protocol https\\n✓ Configured API protocol.\\n✓ Logged in as project_765_bot_ce6b24221b39aa6436b1ca36dc8bfb1c\\n\"}]}]]}]\n43:[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-error/40\"}]\n44:[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}]\n45:[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]\n46:[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-bash\",\"children\":\"helm upgrade --install test gitlab/gitlab-agent \\\\\\n  --namespace gitlab-agent \\\\\\n  --create-namespace \\\\\\n  --set image.tag=v17.9.2 \\\\\\n  --set config.token=glagent-GD-********** \\\\\\n  --set config.kasAddress=wss://gitlab.adinusa.id/-/kubernetes-agent/ \\\\\\n  --set rbac.create=false \\\\\\n  --set serviceAccount.name=gitlab-runner \\\\\\n  --set serviceAccount.create=false \\n\"}]}]\n47:[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-primary/40\"}]\n48:[\"$\",\"div\",null,{\"className\":\"w-2 h-2 rounded-full bg-secondary/40\"}]\n49:[\"$\",\"pre\",null,{\"className\":\"p-6 text-sm font-mono text-primary-fixed/80 leading-relaxed w-full min-w-max whitespace-pre\",\"children\":[\"$\",\"code\",\"code-0\",{\"className\":\"language-bash\",\"children\":\"kubectl auth can-i get pods --as=system:serviceaccount:gitlab-agent-test:gitlab-runner -n gitlab-runner\\n\"}]}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n4a:I[27201,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"IconMark\"]\n7:null\nc:[[\"$\",\"title\",\"0\