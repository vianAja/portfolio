\"]\\n\"])</script><script>self.__next_f.push([1,\":HL[\\\"/assets/images/kube-agent/alur-kerja.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/1.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/2.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/3.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/4.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/5.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/6.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/7.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/8.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/10.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/11.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/12.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/13.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/14.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/15.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/16.png\\\",\\\"image\\\"]\\n:HL[\\\"/assets/images/kube-agent/hasil-pengujian.png\\\",\\\"image\\\"]\\n11:[\\\"$\\\",\\\"div\\\",\\\"p-1\\\",{\\\"className\\\":\\\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\\\",\\\"children\\\":\\\"Untuk menjawab kebutuhan tersebut, GitLab menyediakan solusi bernama GitLab Kubernetes Agent (KAS), sebuah mekanisme komunikasi terenkripsi yang memungkinkan GitLab terhubung secara aman dan efisien ke cluster Kubernetes, tanpa perlu menyimpan kubeconfig atau token di dalam repository CI/CD.\\\"}]\\n12:[\\\"$\\\",\\\"div\\\",\\\"p-2\\\",{\\\"className\\\":\\\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",\\\"strong-0\\\",{\\\"className\\\":\\\"text-white font-bold\\\",\\\"children\\\":\\\"Apa itu GitLab Kubernetes Agent?\\\"}],\\\"\\\\nGitLab Kubernetes Agent adalah komponen yang berjalan di dalam cluster Kubernetes dan bertugas membangun koneksi dua arah yang terenkripsi dengan server GitLab melalui Kubernetes Agent Server (KAS). Mekanisme ini memungkinkan berbagai fitur seperti:\\\"]}]\\n13:[\\\"$\\\",\\\"ul\\\",\\\"ul-0\\\",{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-0\\\",{\\\"children\\\":\\\"Deployment otomatis dari pipeline GitLab ke cluster Kubernetes\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-1\\\",{\\\"children\\\":\\\"Sinkronisasi GitOps menggunakan pull-based approach, yang dimana nanti dari si Agent yang ada di kubenetes akan pull / mengambil data yang ada di repositori GitLab, lalu di apply.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-2\\\",{\\\"children\\\":\\\"Manajemen akses yang lebih fleksibel, aman dan terpusat hanya di GitLab dan Kubernetesnya saja.\\\"}],\\\"\\\\n\\\"]}]\\n14:[\\\"$\\\",\\\"div\\\",\\\"p-3\\\",{\\\"className\\\":\\\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\\\",\\\"children\\\":[\\\"$\\\",\\\"strong\\\",\\\"strong-0\\\",{\\\"className\\\":\\\"text-white font-bold\\\",\\\"children\\\":\\\"Arsitektur KAS Secara Singkat\\\"}]}]\\n15:[\\\"$\\\",\\\"ul\\\",\\\"ul-1\\\",{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-0\\\",{\\\"children\\\":\\\"GitLab Kubernetes Agent (gitlab-agent) dideploy sebagai pod di dalam cluster Kubernetes.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-1\\\",{\\\"children\\\":\\\"Kubernetes Agent Server (KAS) merupakan komponen server yang dijalankan oleh GitLab.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-2\\\",{\\\"children\\\":\\\"Kemudian komunikasi antara gitlab-agent dan KAS menggunakan gRPC (Google Remote Procedure Call) untuk memastikan keamanan dan integritas data.\\\"}],\\\"\\\\n\\\"]}]\\n16:[\\\"$\\\",\\\"h4\\\",\\\"h4-0\\\",{\\\"children\\\":\\\"Kelebihan\\\"}]\\n17:[\\\"$\\\",\\\"ul\\\",\\\"ul-2\\\",{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-0\\\",{\\\"children\\\":\\\"Keamanan lebih tinggi, karena tidak perlu expose API server ke luar dan hanya membuat sebuah tunnel untuk komunikasi antara gitlab-agent dan KAS.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-1\\\",{\\\"children\\\":\\\"Semua ada pada GitLab, jadi tidak perlu tools tambahan lain seperti Flux atau ArgoCD dll.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-2\\\",{\\\"children\\\":\\\"Access Control terpusat, karena hanya menggunakan RBAC dari GitLab dan Kubernetes nya saja.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-3\\\",{\\\"children\\\":\\\"Cukup mudah konfigurasinya, karena tidak perlu tambahan tools lain, jadi hanya fokus ke GitLab dan Kubernetesnya saja jadi tidak ada konfigurasi tambahan.\\\"}],\\\"\\\\n\\\"]}]\\n18:[\\\"$\\\",\\\"h4\\\",\\\"h4-1\\\",{\\\"children\\\":\\\"Kekurangan\\\"}]\\n19:[\\\"$\\\",\\\"ul\\\",\\\"ul-3\\\",{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-0\\\",{\\\"children\\\":\\\"Keterbatasan fitur GitOps, karena tanpa menggunakan tools lain seperti Flux atau ArgoCD, jadi fitur yang dimiliki cukup terbatas, tidak se-fleksible Flux/ArgoCD.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-1\\\",{\\\"children\\\":\\\"Ketergantungan pada GitLab, karena si agent nya ini hanya dapat bekerja di ekosistem GitLab saja.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-2\\\",{\\\"children\\\":\\\"Konfigurasi Awal cukup ribet, harus benar - benar \"])</script><script>self.__next_f.push([1,\"mengetahui terkait GitLab dan Kubernetes cukup dalam, karena hanya berfokus pada 2 tools itu.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",\\\"li-3\\\",{\\\"children\\\":\\\"Komunitas yang lebih sempit, tidak seperti Flux / ArgoCD yang sudah ada komunitas yang cukup besar.\\\"}],\\\"\\\\n\\\"]}]\\n1a:[\\\"$\\\",\\\"h3\\\",\\\"h3-0\\\",{\\\"className\\\":\\\"font-headline text-2xl font-bold text-white tracking-tight mt-10 mb-3\\\",\\\"children\\\":\\\"Topologi\\\"}]\\n1b:[\\\"$\\\",\\\"div\\\",\\\"p-4\\\",{\\\"className\\\":\\\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\\\",\\\"children\\\":[\\\"$\\\",\\\"img\\\",\\\"img-0\\\",{\\\"src\\\":\\\