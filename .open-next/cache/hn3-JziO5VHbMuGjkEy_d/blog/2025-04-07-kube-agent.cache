i cluster kubenetes ke GitLab di bagian \",[\"$\",\"em\",\"em-0\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"--set config.token=\\\"\"}]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"children\":[\"Lalu atur kasAddress juga \",[\"$\",\"em\",\"em-0\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"\\\"--set config.kasAddress=\\\"\"}]}],\", sesuaikan dengan GitLab yang digunakan.\"]}],\"\\n\",[\"$\",\"li\",\"li-4\",{\"children\":[\"Lalu tambahkan juga untuk ServiceAccount nya di bagian \",[\"$\",\"em\",\"em-0\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"\\\"--set serviceAccount.name=\\\"\"}]}],\".\"]}],\"\\n\",[\"$\",\"li\",\"li-5\",{\"children\":[\"Lalu karena sudah di buat untuk ServiceAccount nya, tambahkan \",[\"$\",\"em\",\"em-0\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"\\\"--set serviceAccount.create=false\\\"\"}]}],\" dan \",[\"$\",\"em\",\"em-1\",{\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-white font-bold\",\"children\":\"\\\"--set rbac.create=false\\\"\"}]}],\" agar tidak membuat RBAC dan ServiceAccount baru, agar menggunakan sesuai yang sudah di setting.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"div\",\"p-1\",{\"className\":\"text-on-surface/80 font-body text-lg leading-[1.6] my-4\",\"children\":\"sebagai contoh saya menggunakan settingan seperti berikut ini.\"}],\"\\n\",[\"$\",\"div\",\"pre-0\",{\"className\":\"rounded-xl overflow-x-auto bg-surface-container-lowest border border-outline-variant/10 my-6 w-full shadow-lg\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2 bg-surface-container-high border-b border-outline-variant/10 min-w-max\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label text-[0.6875rem] text-outline uppercase tracking-widest\",\"children\":\"bash